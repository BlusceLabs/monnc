---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NotFound from '../../../components/NotFound.astro';
import ScoreRing from '../../../components/ScoreRing.svelte';
import CastRow from '../../../components/CastRow.svelte';
import Rail from '../../../components/Rail.astro';
import { tmdb } from '../../../lib/tmdb';
import { hasCredentials, REGION } from '../../../lib/config';
import { backdrop, poster, logo } from '../../../lib/image';
import { prettyDate, runtime, money, mediaTitle } from '../../../lib/format';

const { type, id } = Astro.params;
let notFound = !(type === 'movie' || type === 'tv');
const isMovie = type === 'movie';

let m = null, error = null;
if (!notFound && hasCredentials) {
  try { m = isMovie ? await tmdb.movie(id) : await tmdb.tv(id); }
  catch (err) { error = err.message; }
}
if (!m && !error) notFound = true;

if (notFound) Astro.response.status = 404;

const vids = m?.videos?.results ?? [];
const trailer = vids.find((v) => v.site === 'YouTube' && v.type === 'Trailer') || vids.find((v) => v.site === 'YouTube');
const trailerUrl = trailer ? 'https://www.youtube.com/watch?v=' + trailer.key : null;
const director = m?.credits?.crew?.find((c) => c.job === 'Director');
const writers = m?.credits?.crew?.filter((c) => ['Screenplay', 'Writer', 'Story'].includes(c.job)).slice(0, 3) || [];
const creators = (m?.created_by || []).map((c) => c.name).join(', ') || '';
const providers = m?.['watch/providers']?.results?.[REGION]?.flatrate || [];
const networks = m?.networks || [];
const seasons = (m?.seasons || []).filter((s) => s.season_number);
const title = mediaTitle(m);
const date = isMovie ? m?.release_date : m?.first_air_date;
const year = (date || '').slice(0, 4);
---

{notFound ? (
  <NotFound />
) : (
<BaseLayout title={title} description={m?.overview} backdrop={m ? backdrop(m.backdrop_path) : null}>
  {error && <div class="container" style="padding-top:40px"><div class="empty">{error}</div></div>}
  {m && (
    <>
      <section class="detail container">
        <div class="poster-col">
          <img class="poster" src={poster(m.poster_path, 'original')} alt={title} />
          <div class="row actions">
            <a class="btn btn-primary" href={`/watch/${type}/${m.id}`}>▶ Watch</a>
            {trailerUrl && <a class="btn btn-ghost" href={trailerUrl} target="_blank" rel="noopener">Trailer</a>}
          </div>
        </div>
        <div class="info">
          <h1>{title} <span class="yr">({year})</span></h1>
          {!isMovie && m.tagline && <p class="tagline">"{m.tagline}"</p>}
          <div class="row facts">
            {!isMovie && m.number_of_seasons ? <span>{m.number_of_seasons} season{m.number_of_seasons > 1 ? 's' : ''}</span> : null}
            <span>{prettyDate(date)}</span>
            {isMovie && m.runtime ? <span>· {runtime(m.runtime)}</span> : null}
            {m.status ? <span>· {m.status}</span> : null}
          </div>
          <div class="row genres">
            {m.genres?.map((g) => <a class="chip" href={`/genre/${type}/${g.id}`}>{g.name}</a>)}
          </div>
          <div class="row score-row">
            <ScoreRing client:visible value={m.vote_average} size={62} />
            <div><strong>User score</strong><br /><span class="muted">{m.vote_count?.toLocaleString()} votes</span></div>
          </div>
          <h3>Overview</h3>
          <p class="overview">{m.overview || 'No overview available.'}</p>
          <div class="crew">
            {isMovie && director && <div><strong>{director.name}</strong><span class="muted">Director</span></div>}
            {isMovie && writers.map((w) => <div><strong>{w.name}</strong><span class="muted">{w.job}</span></div>)}
            {!isMovie && creators && <div><strong>{creators}</strong><span class="muted">{creators.includes(',') || creators.includes('&') ? 'Creators' : 'Creator'}</span></div>}
          </div>
          <div class="row stats">
            {isMovie && (
              <>
                <div><span class="muted">Budget</span><strong>{money(m.budget)}</strong></div>
                <div><span class="muted">Revenue</span><strong>{money(m.revenue)}</strong></div>
              </>
            )}
            {!isMovie && (
              <div><span class="muted">Episode runtime</span><strong>{(m.episode_run_time && m.episode_run_time[0]) ? runtime(m.episode_run_time[0]) : '—'}</strong></div>
            )}
            <div><span class="muted">Language</span><strong>{(m.original_language || '').toUpperCase()}</strong></div>
          </div>
          {networks.length > 0 && (
            <div class="providers">
              <span class="muted">Network{networks.length > 1 ? 's' : ''}</span>
              <div class="row">{networks.map((n) => <span class="chip">{n.name}</span>)}</div>
            </div>
          )}
          {providers.length > 0 && (
            <div class="providers">
              <span class="muted">Streaming on</span>
              <div class="row">{providers.map((p) => <img class="prov" src={logo(p.logo_path, 'w45')} alt={p.provider_name} title={p.provider_name} />)}</div>
            </div>
          )}
        </div>
      </section>

      {!isMovie && seasons.length > 0 && (
        <section class="section container">
          <div class="section-head"><h2>Seasons</h2></div>
          <div class="season-grid">
            {seasons.map((s) => (
              <a class="season" href={`/watch/${type}/${m.id}`}>
                <img src={poster(s.poster_path, 'original')} alt={s.name} loading="lazy" />
                <div class="meta"><strong>{s.name || `Season ${s.season_number}`}</strong><span>{s.episode_count} episodes</span></div>
              </a>
            ))}
          </div>
        </section>
      )}

      {isMovie && m.belongs_to_collection && (
        <section class="section container">
          <a class="collection" href={`/collection/${m.belongs_to_collection.id}`}
             style={`background-image:url(${backdrop(m.belongs_to_collection.backdrop_path)})`}>
            <div><span class="eyebrow">Part of a collection</span><h2>{m.belongs_to_collection.name}</h2>
            <span class="btn btn-primary">View collection →</span></div>
          </a>
        </section>
      )}

      {m.credits?.cast?.length > 0 && (
        <section class="section container"><div class="section-head"><h2>Top billed cast</h2></div>
          <CastRow client:visible cast={m.credits.cast} /></section>
      )}

      <Rail title="Recommended" items={m.recommendations?.results || []} kind={type} />
      <Rail title="More like this" items={m.similar?.results || []} kind={type} />
    </>
  )}

  <style>
    .detail { display: grid; grid-template-columns: 300px 1fr; gap: 40px; padding-top: 48px; align-items: start; }
    .poster { width: 100%; border-radius: var(--radius-lg); border: 1px solid var(--border); box-shadow: var(--shadow-1); }
    .actions { margin-top: 16px; }
    .actions .btn { flex: 1; justify-content: center; }
    .info h1 { font-size: clamp(1.8rem, 4vw, 2.8rem); }
    .yr { color: var(--text-dim); font-weight: 400; }
    .tagline { color: var(--mustard); font-style: italic; margin: 6px 0 14px; }
    .facts { gap: 10px; color: var(--text-dim); margin-bottom: 14px; }
    .genres { margin-bottom: 20px; }
    .score-row { gap: 14px; margin-bottom: 24px; }
    .overview { max-width: 68ch; margin-bottom: 22px; }
    .crew { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 14px; margin-bottom: 24px; }
    .crew strong { display: block; } .crew span { font-size: 0.85rem; }
    .stats { gap: 32px; padding: 18px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); flex-wrap: wrap; }
    .stats div { display: flex; flex-direction: column; } .stats span { font-size: 0.8rem; }
    .providers { margin-top: 18px; } .providers .row { margin-top: 8px; }
    .prov { width: 44px; height: 44px; border-radius: 10px; border: 1px solid var(--border); }
    .season-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 18px; }
    .season { display: block; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border); background: var(--charcoal-800); transition: transform .2s, border-color .2s; }
    .season:hover { transform: translateY(-4px); border-color: var(--mustard-deep); }
    .season img { width: 100%; aspect-ratio: 2 / 3; object-fit: cover; }
    .season .meta { padding: 10px 12px; } .season strong { display: block; font-size: 0.92rem; } .season span { font-size: 0.8rem; color: var(--text-dim); }
    .collection { display: flex; align-items: flex-end; min-height: 200px; border-radius: var(--radius-lg); padding: 28px; background-size: cover; background-position: center; position: relative; overflow: hidden; }
    .collection::before { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(16,17,19,0.92), rgba(16,17,19,0.55)); }
    .collection > div { position: relative; z-index: 2; } .collection h2 { margin: 6px 0 14px; }
    @media (max-width: 820px) { .detail { grid-template-columns: 1fr; } .poster { max-width: 260px; } }
  </style>
</BaseLayout>
)}
