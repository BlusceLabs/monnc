---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NotFound from '../../../components/NotFound.astro';
import ScoreRing from '../../../components/ScoreRing.svelte';
import CastRow from '../../../components/CastRow.svelte';
import Rail from '../../../components/Rail.astro';
import Trailer from '../../../components/Trailer.svelte';
import EpisodePlayer from '../../../components/EpisodePlayer.svelte';
import { tmdb } from '../../../lib/tmdb';
import { hasCredentials, REGION, API_BASE } from '../../../lib/config';
import { poster, backdrop } from '../../../lib/image';
import { prettyDate, runtime, money, mediaTitle } from '../../../lib/format';

const { type, id } = Astro.params;
let notFound = !(type === 'movie' || type === 'tv');
const isMovie = type === 'movie';

let m = null, error = null;
let seasons = [];
if (!notFound && hasCredentials) {
  try {
    m = isMovie ? await tmdb.movie(id) : await tmdb.tv(id);
    if (!isMovie) seasons = await tmdb.tvSeasons(id);
  } catch (err) { error = err.message; }
}
if (!m && !error) notFound = true;
if (notFound) Astro.response.status = 404;

const title = m ? mediaTitle(m) : '';
const date = isMovie ? m?.release_date : m?.first_air_date;
const year = (date || '').slice(0, 4);
const genres = (m?.genres || []).filter((g) => g && g.id);
const vids = m?.videos?.results ?? [];
const trailer = vids.find((v) => v.site === 'YouTube' && v.type === 'Trailer') || vids.find((v) => v.site === 'YouTube') || null;
const trailerKey = trailer?.key || null;
const director = m?.credits?.crew?.find((c) => c.job === 'Director');
const writers = (m?.credits?.crew || []).filter((c) => ['Screenplay', 'Writer', 'Story'].includes(c.job)).slice(0, 3);
const creators = (m?.created_by || []).map((c) => c.name).join(', ') || '';
const providers = m?.['watch/providers']?.results?.[REGION]?.flatrate || [];
const networks = m?.networks || [];
const cast = m?.credits?.cast || [];
const recs = (m?.recommendations?.results || []).filter((x) => x && (x.poster_path || x.profile_path || x.backdrop_path)).slice(0, 20);
const similar = (m?.similar?.results || []).filter((x) => x && (x.poster_path || x.profile_path || x.backdrop_path)).slice(0, 20);

const heroBackdrop = m?.backdrop_path ? backdrop(m.backdrop_path, 'original') : null;
const heroPoster = m?.poster_path ? poster(m.poster_path, 'w342') : poster(null, 'w342');
const metaBits = [];
if (isMovie && m?.runtime) metaBits.push(runtime(m.runtime));
else if (!isMovie && m?.number_of_seasons) metaBits.push(`${m.number_of_seasons} season${m.number_of_seasons > 1 ? 's' : ''}`);
if (date) metaBits.push(prettyDate(date));
if (m?.status) metaBits.push(m.status);
---

{
  !m ? (
    <NotFound />
  ) : (
    <BaseLayout title={title} description={m?.overview} backdrop={heroBackdrop}>
      {error && <div class="container" style="padding-top:40px"><div class="empty">{error}</div></div>}
      {m && (
        <article class="detail">
          <header class="hero" style={heroBackdrop ? `--hb:url(${heroBackdrop})` : ''}>
            <div class="hero-grad"></div>
            <div class="container hero-inner">
              <img class="poster" src={heroPoster} alt={title} />
              <div class="info">
                <h1>{title}{year && <span class="yr"> ({year})</span>}</h1>
                {!isMovie && m?.tagline && <p class="tagline">“{m.tagline}”</p>}
                <div class="facts">
                  {metaBits.map((b) => <span>{b}</span>)}
                </div>
                {genres.length > 0 && (
                  <div class="genres">
                    {genres.map((g) => <a class="chip" href={`/genre/${type}/${g.id}`}>{g.name}</a>)}
                  </div>
                )}
                <div class="actions">
                  <a class="btn btn-primary" href={`/watch/${type}/${m.id}`}>▶ Watch</a>
                </div>
              </div>
            </div>
          </header>

          <div class="container body">
            <section class="overview-block">
              {m.vote_average ? (
                <div class="score-row">
                  <ScoreRing client:visible value={m.vote_average} size={66} />
                  <div><strong>User score</strong><br /><span class="muted">{m.vote_count?.toLocaleString()} votes</span></div>
                </div>
              ) : null}
              <h3>Overview</h3>
              <p class="overview">{m.overview || 'No overview available.'}</p>
              <div class="crew">
                {isMovie && director && <div><strong>{director.name}</strong><span class="muted">Director</span></div>}
                {isMovie && writers.map((w) => <div><strong>{w.name}</strong><span class="muted">{w.job}</span></div>)}
                {!isMovie && creators && <div><strong>{creators}</strong><span class="muted">{creators.includes(',') || creators.includes('&') ? 'Creators' : 'Creator'}</span></div>}
                {isMovie && m.budget ? <div><span class="muted">Budget</span><strong>{money(m.budget)}</strong></div> : null}
                {isMovie && m.revenue ? <div><span class="muted">Revenue</span><strong>{money(m.revenue)}</strong></div> : null}
                {!isMovie && m.episode_run_time?.[0] ? <div><span class="muted">Episode runtime</span><strong>{runtime(m.episode_run_time[0])}</strong></div> : null}
                <div><span class="muted">Language</span><strong>{(m.original_language || '').toUpperCase()}</strong></div>
              </div>
              {networks.length > 0 && (
                <div class="providers">
                  <span class="muted">Network{networks.length > 1 ? 's' : ''}</span>
                  <div class="row">{networks.map((n) => <span class="chip">{n.name}</span>)}</div>
                </div>
              )}
              {providers.length > 0 && (
                <div class="providers">
                  <span class="muted">Streaming on</span>
                  <div class="row">{providers.map((p) => <img class="prov" src={poster(p.logo_path, 'w45')} alt={p.provider_name} title={p.provider_name} />)}</div>
                </div>
              )}
            </section>

            {cast.length > 0 && (
              <section class="section">
                <div class="section-head"><h2>Top billed cast</h2></div>
                <CastRow client:visible cast={cast} />
              </section>
            )}

            {trailerKey && (
              <section class="section">
                <div class="section-head"><h2>Trailer</h2></div>
                <Trailer client:visible key={trailerKey} poster={heroBackdrop || ''} title={title} />
              </section>
            )}

            {!isMovie && seasons.length > 0 && (
              <section class="section">
                <div class="section-head"><h2>Seasons & episodes</h2></div>
                <EpisodePlayer client:visible tvId={String(m.id)} seasons={seasons} initialSeason={1} />
              </section>
            )}

            {recs.length > 0 && <Rail title="Recommended" items={recs} kind={type} />}
            {similar.length > 0 && <Rail title="More like this" items={similar} kind={type} />}
          </div>
        </article>
      )}

      <style>
        .detail { padding-bottom: 60px; }
        /* ---- Hero ---- */
        .hero { position: relative; padding: 36px 0 30px; overflow: hidden; }
        .hero-grad { position: absolute; inset: 0; background: var(--hb, none) center 18% / cover no-repeat; opacity: 0.42; filter: saturate(0.85); }
        .hero-grad::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(16,17,19,0.55), rgba(16,17,19,0.92) 88%); }
        .hero-inner { position: relative; display: grid; grid-template-columns: 260px 1fr; gap: 32px; align-items: end; }
        .poster { width: 100%; border-radius: var(--radius-lg); border: 1px solid var(--border); box-shadow: var(--shadow-1); background: var(--charcoal-800); }
        .info h1 { font-size: clamp(1.8rem, 4.4vw, 3rem); line-height: 1.05; margin: 0; }
        .yr { color: var(--text-dim); font-weight: 400; }
        .tagline { color: var(--mustard); font-style: italic; margin: 8px 0 14px; }
        .facts { display: flex; flex-wrap: wrap; gap: 8px 18px; color: var(--text-dim); margin-bottom: 16px; }
        .genres { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }
        .actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
        .trailer-btn { padding: 0; border: none; background: transparent; }
        /* ---- Body ---- */
        .body { margin-top: 8px; }
        .overview-block { max-width: 820px; }
        .score-row { display: flex; align-items: center; gap: 14px; margin-bottom: 22px; }
        .overview { max-width: 68ch; line-height: 1.62; color: var(--text); opacity: 0.92; }
        .crew { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 14px; margin: 22px 0; }
        .crew strong { display: block; } .crew span { font-size: 0.82rem; }
        .providers { margin-top: 18px; } .providers .row { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
        .prov { width: 44px; height: 44px; border-radius: 10px; border: 1px solid var(--border); }
        .section { margin-top: 40px; }
        @media (max-width: 760px) { .hero-inner { grid-template-columns: 140px 1fr; gap: 18px; } .poster { max-width: 140px; } }
      </style>
    </BaseLayout>
  )
}
