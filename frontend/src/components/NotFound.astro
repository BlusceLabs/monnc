---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  code?: string;
  title?: string;
  message?: string;
}
const {
  code = '404',
  title = 'Out of frame.',
  message = "The scene you're looking for is missing, has been moved, or doesn't exist anymore.",
} = Astro.props;
---

<BaseLayout title={`Page Not Found - ${code}`}>
  <div class="error-page container">
    <div class="error-content">
      <span class="error-code">{code}</span>
      <h1>{title}</h1>
      <p>{message}</p>

      <a href="/" class="btn-home">
        Return to Home
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .error-page {
    min-height: 75vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 32px 16px;
    position: relative;
  }

  .error-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: fade-in 0.6s ease-out;
  }

  /* Large, subtle background numbers */
  .error-code {
    font-size: clamp(6rem, 20vw, 14rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--border, rgba(255, 255, 255, 0.05));
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -60%);
    z-index: -1;
    pointer-events: none;
    user-select: none;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 16px;
    color: var(--text);
    font-weight: 700;
  }

  p {
    color: var(--text-dim, #7D7A75);
    font-size: 1.1rem;
    line-height: 1.6;
    max-width: 420px;
    margin: 0 0 32px;
  }

  .btn-home {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--mustard, #E6B325);
    color: var(--charcoal, #101113);
    padding: 14px 28px;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .btn-home:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .btn-home:active {
    transform: translateY(0);
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
