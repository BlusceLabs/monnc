---
import { SITE } from '../lib/config';
import SearchBar from './SearchBar.svelte';

const path = Astro.url.pathname;
const links = [
  { href: '/home', label: 'Home' },
  { href: '/movies', label: 'Movies' },
  { href: '/tv', label: 'TV' },
  { href: '/trending', label: 'Trending' },
  { href: '/discover', label: 'Discover' },
  { href: '/people', label: 'People' },
  { href: '/genres', label: 'Genres' },
];
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <span class="brand-mark">M</span>
      <span class="brand-word">{SITE.name}</span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} class={isActive(l.href) ? 'active' : ''}>{l.label}</a>
      ))}
    </nav>

    <div class="nav-search">
      <SearchBar client:idle compact />
    </div>

    <button class="nav-toggle" aria-label="Toggle menu" data-toggle>☰</button>
  </div>

  <div class="nav-drawer" data-drawer hidden>
    {links.map((l) => (
      <a href={l.href} class={isActive(l.href) ? 'active' : ''}>{l.label}</a>
    ))}
  </div>
</header>

<style>
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    height: var(--nav-h);
    background: rgba(16, 17, 19, 0.72);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner { height: var(--nav-h); display: flex; align-items: center; gap: 24px; }
  .brand { display: flex; align-items: center; gap: 10px; font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; }
  .brand-mark {
    display: grid; place-items: center; width: 34px; height: 34px;
    background: var(--mustard); color: var(--charcoal-900);
    border-radius: 10px; font-weight: 700;
  }
  .nav-links { display: flex; gap: 4px; margin-right: auto; }
  .nav-links a {
    padding: 8px 14px; border-radius: var(--radius-pill);
    color: var(--text-dim); font-weight: 500; font-size: 0.94rem; transition: color .2s, background .2s;
  }
  .nav-links a:hover { color: var(--text); }
  .nav-links a.active { color: var(--mustard); background: var(--mustard-tint); }
  .nav-search { width: min(320px, 34vw); }
  .nav-toggle { display: none; background: none; border: none; color: var(--text); font-size: 1.5rem; cursor: pointer; }
  .nav-drawer { display: none; flex-direction: column; padding: 8px 24px 16px; gap: 4px; background: var(--charcoal-900); border-bottom: 1px solid var(--border); }
  .nav-drawer a { padding: 12px; border-radius: var(--radius-sm); color: var(--text-dim); }
  .nav-drawer a.active { color: var(--mustard); }

  @media (max-width: 900px) {
    .nav-links { display: none; }
    .nav-search { width: 180px; }
  }
  @media (max-width: 640px) {
    .nav-search { display: none; }
    .nav-toggle { display: block; }
    .nav-drawer[data-open] { display: flex; }
  }
</style>

<script>
  const toggle = document.querySelector('[data-toggle]');
  const drawer = document.querySelector('[data-drawer]');
  toggle?.addEventListener('click', () => {
    if (!drawer) return;
    const open = drawer.hasAttribute('data-open');
    if (open) { drawer.removeAttribute('data-open'); drawer.setAttribute('hidden', ''); }
    else { drawer.setAttribute('data-open', ''); drawer.removeAttribute('hidden'); }
  });
</script>
