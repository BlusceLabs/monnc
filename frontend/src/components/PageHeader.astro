---
interface Props { title: string; eyebrow?: string; sub?: string; }
const { title, eyebrow, sub } = Astro.props;
---
<header class="page-header">
  <div class="container">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {sub && <p class="muted">{sub}</p>}
    <slot />
  </div>
</header>
<style>
  .page-header { padding: 40px 0 8px; }
  .page-header h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: 8px 0 6px; }
  .page-header p { max-width: 640px; }
</style>
