# ── Backend API server (app.py) ──────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8028

# Origins allowed to call the API (the Astro dev/preview server).
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# ── TMDB (kept server-side; the frontend never sees these) ───────────────────
# Use a v4 Read Access Token (preferred) or a classic v3 API key.
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=
TMDB_BASE=https://api.themoviedb.org/3

# ── 111movies / MovieBox streaming pipeline (stream.py) ──────────────────────
FETCH_TIMEOUT_MS=20000

# ── HEVC→H.264 transcoding proxy (proxy.py, mounted at /px) ────────────────
# Leave MEDIA_SERVER empty to use the proxy purely as a ?target= gateway.
MEDIA_SERVER=
PROXY_ALLOW_EXTERNAL_TARGETS=true
PROXY_HOST=0.0.0.0
PROXY_PORT=8080
